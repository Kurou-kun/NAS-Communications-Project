#define APSTUDIO_READONLY_SYMBOLS
#include <windows.h>
#undef APSTUDIO_READONLY_SYMBOLS

/////////////////////////////////////////////////////////////////////////////
//
// Version
//
// Bump FILEVERSION and the "FileVersion" string together on every release --
// Rainmeter's skin installer compares FileVersion and will keep the old DLL
// if this does not change.
// ProductName/ProductVersion below are the Rainmeter markers - don't change.
// rc.exe does not define _WIN64 the way cl.exe does, so the x64 configs pass
// it explicitly under <ResourceCompile>. Without that an x64 build stamps
// itself (32-bit) and Rainmeter reads it as the wrong architecture.

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,1,0
 PRODUCTVERSION 4,5,26,3894
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "Kurou"
            VALUE "FileDescription", "Rainmeter plugin for remote monitoring via Prometheus"
            VALUE "FileVersion", "1.1.1.0"
            VALUE "InternalName", "NASCP"
            VALUE "OriginalFilename", "NASCP.dll"
            VALUE "LegalCopyright", "Copyright (c) 2026 - Kurou"

            // Don't change the entries below!
            VALUE "ProductName", "Rainmeter"
#ifdef _WIN64
            VALUE "ProductVersion", "4.5.26.3894 (64-bit)"
#else
            VALUE "ProductVersion", "4.5.26.3894 (32-bit)"
#endif // _WIN64
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
